---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, formatDate } from '../../lib/site';
export async function getStaticPaths() { return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Article title={post.data.title} description={post.data.description} section="Writing" back="blog/" meta={formatDate(post.data.date)} category={post.data.category} tags={post.data.tags}><Content /></Article>
