---
import Home from '../views/Home.astro';
import CustomPage from '../views/CustomPage.astro';
import Base from '../layouts/Base.astro';
import DesignComponents from '../components/DesignComponents.astro';
import { design, getProfile } from '../lib/site';

const page = design.pages.find(({ id }) => id === design.homePage);
const profile = design.homePage === 'landing' ? (await getProfile()).data : undefined;
---
{design.homePage === 'home' ? <Home /> : page ? <CustomPage page={page} isHome /> :
  <Base>
    <div class="container page-content"><header class="page-header">
      <h1>{profile?.name}</h1>
      <p>{profile?.role}</p>
    </header></div>
    <DesignComponents page="home" afterIntro />
  </Base>}
