---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import EmptyState from '../components/EmptyState.astro';
import { getPosts, href } from '../lib/site';
import { collectTags, groupByCategory } from '../lib/content.mjs';
const posts = await getPosts();
const tags = collectTags(posts);
const categories = groupByCategory(posts).filter(({ slug }) => slug);
---
<Base title="Blog" description="Technical writing, engineering notes, and explorations across technologies.">
  <div class="container page-content">
    <header class="page-header"><p class="eyebrow">A notebook, across disciplines</p><h1>Notes &<br /><em>perspectives.</em></h1><p>Things I’ve learned, problems I’ve worked through, and technologies worth exploring.</p></header>
    {categories.length > 0 && <nav class="topic-nav" aria-label="Browse by category">
      <p class="eyebrow browse-label">Categories</p>
      <a class="topic-pill active" href={href('blog/')} aria-current="page">All writing <span>{posts.length}</span></a>
      {categories.map(({ label, slug, entries }) => <a class="topic-pill" href={href(`blog/categories/${slug}/`)}>{label}<span>{entries.length}</span></a>)}
    </nav>}
    {tags.length > 0 && <nav class="topic-nav" aria-label="Browse by technology">
      <p class="eyebrow browse-label">Technology tags</p>
      {categories.length === 0 && <a class="topic-pill active" href={href('blog/')} aria-current="page">All writing <span>{posts.length}</span></a>}
      {tags.map((tag) => <a class="topic-pill" href={href(`blog/topics/${tag.slug}/`)}>{tag.label}<span>{tag.count}</span></a>)}
    </nav>}
    {posts.length ? <PostList posts={posts} /> : <EmptyState eyebrow="The notebook is open" title="The first page is still ahead." description="No articles have been published yet. New posts will appear here so you can browse by category or technology." />}
  </div>
</Base>
